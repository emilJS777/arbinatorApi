DB_CONNECTION_STRING=postgresql+psycopg2://postgres:<password>@localhost:5432/ArbiNatorDb
APP_HOST=0.0.0.0
APP_PORT=5555
ASYNC_DEBUG=false
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=*
